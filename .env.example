# CashFromChaos environment

# --- Operator brain selection ---
# hermes  = THE operator (default). Live brain via the local `hermes` CLI: it
#           drafts the listings and negotiates with buyers. Built on the
#           deterministic policy engine, so every decision/price stays inside
#           CommercePolicy; falls back to deterministic text if the CLI fails.
# fixture = deterministic-only opt-out: no CLI, fully offline, reproducible.
# llm     = alias for hermes.
OPERATOR_BRAIN=hermes

# --- Claude vision analysis (real photo intake) ---
# When a seller submits an actual camera photo (data URI) and Anthropic
# credentials are available, Claude reads the photo: identity, condition,
# US-dollar market band, critical questions. The band feeds the deterministic
# CommercePolicy — vision informs pricing but can never breach policy.
# Leave blank to always use the offline archetype path. Set VISION=off to
# disable even when credentials exist.
ANTHROPIC_API_KEY=
# VISION=off

# --- Stripe (test mode) ---
# Leave blank to run in SIMULATED payment mode (no network, fully demoable).
# Provide a test-mode secret key (sk_test_...) to use real Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL used for Stripe redirect URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Hermes CLI operator (the default operator; skipped only with OPERATOR_BRAIN=fixture) ---
# The app shells out to a Hermes profile in single-shot mode (`<bin> -z ...`).
# DEFAULT BIN = `hackathon` (the isolated profile wrapper), NOT `hermes` — bare
# `hermes` would bill the user's personal `default` profile (OpenAI Codex /
# ChatGPT Plus) and exhaust their personal quota. Configure the hackathon
# profile once with: `hackathon portal` then `hackathon model` (Nemotron).
HERMES_BIN=hackathon
# HERMES_MODEL=...               # leave unset to use the profile's default model
# HERMES_TIMEOUT_MS=60000        # per-call timeout before falling back

# --- Notifications ---
# Native macOS notifications on buyer engagement, escalations, deals,
# payments and payouts (osascript). On by default on macOS; NOTIFY=off to
# silence. No-op on other platforms.
# NOTIFY=off

# --- Real eBay adapter (sandbox-first) ---
# Leave blank to keep eBay as a mock channel. To actually list:
#  1. Create an eBay developer account + a SANDBOX keyset (client id/secret):
#     https://developer.ebay.com/my/keys
#  2. Mint a user refresh token with the sell.inventory scope (the developer
#     portal's "User Tokens" page → OAuth, sign in with a sandbox test user).
#  3. On the sandbox seller account, create business policies (fulfillment /
#     payment / return) and an inventory location, and paste their IDs below.
# Then: POST /api/ebay/publish {"itemId": "..."} publishes a listing draft;
# POST /api/ebay/poll routes incoming Best Offers through the policy engine
# (accept/counter/decline exactly like the sandbox buyer chat).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENV=sandbox
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=cashfromchaos
EBAY_CATEGORY_ID=
